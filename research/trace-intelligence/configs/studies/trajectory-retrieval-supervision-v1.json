{
  "schema_version": "frankengate-trajectory-retrieval-supervision-v1",
  "purpose": "Content-free contract for exposure-aware trajectory supervision of SQL/tool retrieval.",
  "raw_content_policy": {
    "raw_prompts_sql_tool_arguments_and_rows_external_only": true,
    "raw_content_committed": false,
    "receipts_require_sha256": true,
    "deletion_and_retention_receipts_required": true
  },
  "required_study_fields": [
    "study_id",
    "consent_scope_hash",
    "source_license_or_authorization",
    "candidate_pool_frozen_before_labels",
    "exposure_log_complete",
    "holdouts",
    "arms",
    "minimum_promotion_counts"
  ],
  "required_holdouts": ["principal", "team", "project", "system", "effective_time"],
  "required_episode_fields": [
    "episode_id",
    "case_class",
    "principal_hash",
    "team_hash",
    "project_hash",
    "system_hash",
    "source_environment_hash",
    "changed_environment_hash",
    "effective_at",
    "source_authority_epoch",
    "changed_authority_epoch",
    "split",
    "candidate_pool_hash",
    "exposure_receipt",
    "trajectory_receipt",
    "outcome_receipt",
    "labels",
    "adjudication",
    "deletion_receipt",
    "retention"
  ],
  "required_receipt_fields": ["uri", "sha256"],
  "required_arms": [
    "structured_scope",
    "lexical_identifier",
    "frozen_dense",
    "trajectory_distilled_ranker",
    "frontier_review",
    "regeneration_control"
  ],
  "split_values": ["train", "validation", "test"],
  "case_classes": ["target", "hard_negative", "nil", "unclear"],
  "label_values": ["useful", "not_useful", "not_exposed", "wrong_system", "stale", "nil", "unclear"],
  "minimum_promotion_counts": {
    "target": 100,
    "hard_negative": 50,
    "nil_or_unclear": 25,
    "annotators_per_episode": 2
  },
  "negative_policy": {
    "not_exposed_is_missing_data": true,
    "not_exposed_cannot_be_negative_label": true,
    "exposed_and_skipped_requires_reason": true,
    "same_surface_wrong_system_is_separate_stratum": true,
    "temporal_replacement_is_separate_stratum": true,
    "stale_authority_is_separate_stratum": true
  }
}
