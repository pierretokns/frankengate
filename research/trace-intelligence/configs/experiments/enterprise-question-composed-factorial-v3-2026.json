      "gold": "independent_task_family_objective_environment_and_tool_labels",
      "standalone_arms": [
        ["M0"],
        ["M1"],
        ["M2"],
        ["M3"]
      ],
      "composed_arms": [
        ["M0", "M1"],
        ["M0", "M3"],
        ["M0", "M2"],
        ["M0", "M1", "M2", "M3"],
        ["M0", "M1", "M2", "M3", "M16"]
