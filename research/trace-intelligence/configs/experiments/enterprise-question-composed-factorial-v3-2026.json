  "composition_rules": {
    "allowed": [
      "cheap_signals_select_expensive_review_without_changing_gold",
      "deterministic_invariants_supply_evidence_to_blinded_reasoner",
      "retrieval_supplies_candidates_to_reasoning_with_separate_component_metrics",
      "schema_candidates_feed_temporal_validation_as_hypotheses",
      "dream_consolidation_consumes_only_verified_pre_query_candidates",
      "bounded_candidate_search_feeds_independent_release_lifecycle"
    ],
    "forbidden": [
      "one_arm_reduced_representation_used_as_source_truth_for_another",
      "several_independent_writers_mutate_the_same_live_memory_or_skill",
      "generated_eval_from_trace_T_evaluates_skill_induced_from_T",
      "memory_or_skill_influenced_trace_validates_its_own_release",
      "graph_or_vector_namespace_substitutes_for_RLS_authority",
      "similarity_widens_user_team_or_enterprise_scope",
      "same_outcome_label_is_counted_as_independent_evidence_by_multiple_components",
      "model_generated_gold_is_pooled_with_executable_or_human_gold",
      "hidden_test_examples_or_outcomes_reach_proposal_or_selection_workers"
    ]
  },
  "analysis": {
    "primary_unit": "query_or_task_not_model_invocation",
    "source_family_fixed_strata": true,
    "project_or_task_family_clustered": true,
    "paired_comparisons": true,
    "interaction_estimands_required_for_composed_arms": true,
    "paired_bootstrap_intervals": true,
    "paired_binary_test_when_applicable": true,
    "holm_correction_within_each_benchmark_family": true,
    "pooled_score_across_benchmarks": false,
    "per_domain_and_tail_reporting": true
  },
  "architecture_replacement_gates": {
    "leave_aurora_only_if": [
      "frozen_correctness_requirement_fails",
      "selective_RLS_top_k_requirement_fails_after_measured_tuning",
      "p95_latency_or_concurrency_SLO_fails_at_projected_scale",
      "required_extension_is_unavailable_and_its_measured_gain_exceeds_operational_cost",
      "storage_or_write_amplification_exceeds_budget"
