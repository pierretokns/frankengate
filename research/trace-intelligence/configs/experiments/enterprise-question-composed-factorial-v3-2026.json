      "RLS_or_equivalent_pre_ranking_authority",
      "churn_VACUUM_crash_failover_corruption_and_repair",
      "deletion_and_derivative_closure",
      "HA_PITR_upgrade_and_day_two_cost"
    ],
    "no_decision_from_feature_checklist_alone": true
  },
  "execution_order": [
    "Q2_cheap_signals_and_friction_labels",
    "Q1_same_work_retrieval",
    "Q3_eval_and_diagnosis",
    "Q4_memory_and_dream",
