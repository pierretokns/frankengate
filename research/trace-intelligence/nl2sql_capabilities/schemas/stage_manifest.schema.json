{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankengate.invalid/schemas/fg-stage-manifest-v1.json",
  "title": "Frankengate signed NL2SQL stage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "fold_id",
        "stage_role",
        "manifest_sequence",
        "created_at_unix_ms",
        "parent_design_sha256",
        "cohort_manifest_sha256",
        "dataset_manifest_sha256",
        "prompt_contract_sha256",
        "tool_contract_sha256",
        "model_manifest_sha256",
        "authority_snapshot_sha256",
        "policy_version_sha256",
        "comparator_version_sha256",
        "database_snapshots",
        "artifact_set_sha256",
        "selection_gate_contract_sha256",
        "episode_count",
        "ordered_episode_commitment_sha256",
        "episodes",
        "allowed_runtime_roles"
      ],
      "properties": {
        "schema_version": {"const": "fg-stage-manifest-v1"},
        "experiment_id": {"$ref": "#/$defs/id"},
        "fold_id": {"$ref": "#/$defs/id"},
        "stage_role": {
          "enum": ["evidence", "visible_selection", "hidden_test"]
        },
        "manifest_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parent_design_sha256": {"$ref": "#/$defs/sha256"},
        "cohort_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_contract_sha256": {"$ref": "#/$defs/sha256"},
        "tool_contract_sha256": {"$ref": "#/$defs/sha256"},
        "model_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "authority_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version_sha256": {"$ref": "#/$defs/sha256"},
        "comparator_version_sha256": {"$ref": "#/$defs/sha256"},
        "database_snapshots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["database_ref", "snapshot_sha256"],
            "properties": {
              "database_ref": {"$ref": "#/$defs/database_ref"},
              "snapshot_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
        "selection_gate_contract_sha256": {"$ref": "#/$defs/sha256"},
        "episode_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ordered_episode_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "episodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/episode"}
        },
        "allowed_runtime_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["resolver", "evaluator"]}
        }
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "database_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "payload_sha256",
        "signature_base64url"
      ],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"$ref": "#/$defs/id"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "signature_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_episode_ref",
        "source_task_id",
        "source_file_sha256",
        "source_row_0based",
        "question_sha256",
        "official_instructions_sha256",
        "gold_sql_sha256",
        "database_ref",
        "query_category",
        "primary_quality_eligible",
        "adjudication_ref",
        "paired_seed",
        "arm_order"
      ],
      "properties": {
        "stage_episode_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "source_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_file_sha256": {"$ref": "#/$defs/sha256"},
        "source_row_0based": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "question_sha256": {"$ref": "#/$defs/sha256"},
        "official_instructions_sha256": {"$ref": "#/$defs/sha256"},
        "gold_sql_sha256": {"$ref": "#/$defs/sha256"},
        "database_ref": {"$ref": "#/$defs/database_ref"},
        "query_category": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "primary_quality_eligible": {"type": "boolean"},
        "adjudication_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/id"}
          ]
        },
        "paired_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "arm_order": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["baseline", "placebo", "expert"]}
        }
      }
    }
  }
}
