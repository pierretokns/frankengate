{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankengate.local/schemas/query-result-v1.json",
  "title": "Frankengate canonical full query result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "columns",
    "rows",
    "row_count",
    "result_bytes",
    "result_content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "fg-query-result-v1"
    },
    "columns": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/column"
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "array",
        "maxItems": 2048,
        "items": {
          "$ref": "#/$defs/cell"
        }
      }
    },
    "row_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "result_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "pg_type_oid",
        "format"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "pg_type_oid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "format": {
          "enum": [
            "text",
            "binary"
          ]
        }
      }
    },
    "cell": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "null"
            },
            "value": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:nan|inf|-inf|-?0x(?:0|[1-9a-f][0-9a-f]*)(?:\\.[0-9a-f]*[1-9a-f])?p[+-][0-9]+)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "text",
                "date",
                "time",
                "timestamp",
                "timestamptz",
                "json"
              ]
            },
            "value": {
              "type": "string",
              "maxLength": 4194304
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$",
              "maxLength": 5592406
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "uuid"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "value": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        }
      ]
    }
  }
}
