{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankengate.invalid/schemas/fg-stage-commitment-v1.json",
  "title": "Frankengate public content-free stage commitment",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "fold_id",
        "stage_role",
        "manifest_sequence",
        "created_at_unix_ms",
        "episode_count",
        "input_hashes",
        "stage_manifest_payload_sha256",
        "ordered_episode_commitment_sha256",
        "manifest_signer_key_id"
      ],
      "properties": {
        "schema_version": {"const": "fg-stage-commitment-v1"},
        "experiment_id": {"$ref": "#/$defs/id"},
        "fold_id": {"$ref": "#/$defs/id"},
        "stage_role": {
          "enum": ["evidence", "visible_selection", "hidden_test"]
        },
        "manifest_sequence": {"$ref": "#/$defs/positive_integer"},
        "created_at_unix_ms": {"$ref": "#/$defs/positive_integer"},
        "episode_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parent_design_sha256",
            "cohort_manifest_sha256",
            "dataset_manifest_sha256",
            "prompt_contract_sha256",
            "tool_contract_sha256",
            "model_manifest_sha256",
            "authority_snapshot_sha256",
            "policy_version_sha256",
            "comparator_version_sha256",
            "artifact_set_sha256",
            "selection_gate_contract_sha256"
          ],
          "properties": {
            "parent_design_sha256": {"$ref": "#/$defs/sha256"},
            "cohort_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "prompt_contract_sha256": {"$ref": "#/$defs/sha256"},
            "tool_contract_sha256": {"$ref": "#/$defs/sha256"},
            "model_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "authority_snapshot_sha256": {"$ref": "#/$defs/sha256"},
            "policy_version_sha256": {"$ref": "#/$defs/sha256"},
            "comparator_version_sha256": {"$ref": "#/$defs/sha256"},
            "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
            "selection_gate_contract_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "stage_manifest_payload_sha256": {"$ref": "#/$defs/sha256"},
        "ordered_episode_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_signer_key_id": {"$ref": "#/$defs/id"}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "payload_sha256",
        "signature_base64url"
      ],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"$ref": "#/$defs/id"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "signature_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
