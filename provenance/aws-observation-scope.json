{
  "schema_version": 1,
  "bead_id": "bg-pg-config-mantle-program-gzg9.10",
  "title": "Authorized AWS observation scope and pinned client matrix",
  "effective_date": "2026-07-21",
  "scope_policy": {
    "aws_calls_in_this_bead": false,
    "credentials_in_this_bead": false,
    "paid_inference_in_this_bead": false,
    "future_observations_require_explicit_consent": true,
    "future_observations_require_preconnect_verification": true,
    "naturally_occurring_safe_errors_only": true,
    "unsafe_failure_provocation_allowed": false,
    "prompt_or_response_content_retention_allowed": false
  },
  "authorization": {
    "accounts": {
      "rule": "Exactly one operator-approved AWS account ID or account alias per run record; wildcard or inherited account scope is forbidden.",
      "wildcard_accounts_allowed": false
    },
    "regions": {
      "allowed": ["us-east-1"],
      "additional_regions_require_manifest_update": true
    },
    "projects_or_workspaces": {
      "required": true,
      "native_bedrock": "Record the Bedrock project_id from the key or alias when configured; record default-project when absent.",
      "mantle_openai": "Record the Bedrock project_id sent as OpenAI-Project; record default-project when absent.",
      "mantle_anthropic": "Record the Bedrock project_id sent as anthropic-workspace-id; record default-project when absent."
    },
    "operator": {
      "required": true,
      "rule": "A human operator identity and approval timestamp must be recorded before any connection is attempted."
    },
    "retention": {
      "raw_wire_observations_max_days": 7,
      "redacted_facts_max_days": 90,
      "secrets_retained": false,
      "prompt_response_bodies_retained": false,
      "credential_material_retained": false
    },
    "allowed_facts": [
      "consent_id",
      "operator",
      "client_id",
      "client_version",
      "lane_id",
      "bifrost_container_digest",
      "aws_account_id_or_alias",
      "region",
      "endpoint_host",
      "endpoint_path_template",
      "provider_surface",
      "model_id",
      "project_or_workspace_id",
      "request_id",
      "http_status_class",
      "aws_request_id_if_returned",
      "bifrost_request_id_if_returned",
      "local_latency_ms",
      "local_input_tokens",
      "local_output_tokens",
      "estimated_cost_usd",
      "assurance_level"
    ]
  },
